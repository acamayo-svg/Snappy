# Copiar a .env y completar valores.

FRONTEND_URL=http://localhost:5173

# Supabase (mismo proyecto que el front; validación JWT en la API)
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Wompi — sandbox (prefijos pub_test_, prv_test_, test_integrity_, test_events_)
# Documentación: https://docs.wompi.co/docs/colombia/ambientes-y-llaves/
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_BASE=https://sandbox.wompi.co/v1

# URL pública del API (Render suele definir RENDER_EXTERNAL_URL)
# URL_SERVIDOR=https://tu-api.onrender.com

# Webhook eventos: en dashboard Wompi → Programadores → URL de Eventos:
# https://TU-API.onrender.com/api/pagos/eventos
